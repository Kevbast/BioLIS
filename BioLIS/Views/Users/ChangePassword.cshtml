@model BioLIS.Models.Entities.User

@{
    ViewData["Title"] = "Mi Perfil";
    var swalType = TempData["SwalType"]?.ToString();
    var swalTitle = TempData["SwalTitle"]?.ToString();
    var swalMessage = TempData["SwalMessage"]?.ToString();

    // LÓGICA CORREGIDA PARA AZURE BLOB STORAGE
    var photoFilename = Model?.PhotoFilename;
    var photoUrl = string.IsNullOrWhiteSpace(photoFilename)
        ? "/images/users/default-user.png"
        : photoFilename.Trim();
}

<div class="container mt-4 animate-fade-up">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Ajustes de Cuenta</h2>
            <p class="text-muted">Gestiona tu información pública y tu seguridad.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-light shadow-sm text-dark fw-bold rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i> Volver
        </a>
    </div>

    <div class="row g-4">
        <!-- DATOS DEL USUARIO -->
        <div class="col-lg-5">
            <div class="card premium-card h-100">
                <div class="premium-card-header">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-badge text-primary me-2"></i> Perfil Público</h5>
                </div>
                <div class="card-body text-center p-4">

                    <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" id="updateProfileForm">
                        @Html.AntiForgeryToken()

                        <!-- FOTO INTERACTIVA -->
                        <div class="mb-4">
                            <label for="photoFile" class="profile-pic-wrapper d-inline-block" title="Haz clic para cambiar tu foto">
                                <img src="@photoUrl" alt="Perfil" class="rounded-circle shadow-sm" style="width: 140px; height: 140px; object-fit: cover; border: 4px solid #fff;" onerror="this.src='/images/users/default-user.png'" />
                                <div class="profile-pic-overlay rounded-circle">
                                    <i class="bi bi-camera-fill text-white fs-2"></i>
                                </div>
                            </label>
                            <input type="file" class="d-none" id="photoFile" name="photoFile" accept="image/*" onchange="document.getElementById('updateProfileBtn').click();" />
                            <div class="small text-muted mt-2">Haz clic en la imagen para cambiarla</div>
                        </div>

                        <div class="text-start">
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold text-uppercase">Nombre de Usuario</label>
                                <input type="text" class="form-control form-control-lg bg-light" name="username" value="@Model?.Username" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold text-uppercase">Correo Electrónico</label>
                                <input type="email" class="form-control form-control-lg bg-light" name="email" value="@Model?.Email" placeholder="correo@hospital.com" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-muted small fw-bold text-uppercase">Nivel de Acceso</label>
                                <input type="text" class="form-control form-control-lg bg-white text-muted" value="@(Model?.RoleID == 1 ? "Administrador" : Model?.RoleID == 3 ? "Doctor" : "Laboratorio")" readonly disabled />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold" id="updateProfileBtn">
                                Guardar Cambios de Perfil
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <!-- CONTRASEÑA -->
        <div class="col-lg-7">
            <div class="card premium-card h-100">
                <div class="premium-card-header">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-shield-lock text-success me-2"></i> Seguridad</h5>
                </div>
                <div class="card-body p-4 p-md-5">

                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label text-dark fw-bold">Contraseña Actual</label>
                            <input type="password" class="form-control form-control-lg" id="currentPassword" name="currentPassword" required placeholder="••••••••" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-dark fw-bold">Nueva Contraseña</label>
                            <input type="password" class="form-control form-control-lg" id="newPassword" name="newPassword" required minlength="5" placeholder="Mínimo 5 caracteres" />
                        </div>

                        <div class="mb-5">
                            <label class="form-label text-dark fw-bold">Confirmar Nueva Contraseña</label>
                            <input type="password" class="form-control form-control-lg" id="confirmPassword" name="confirmPassword" required placeholder="Repite la contraseña" />
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold" id="btnChangePassword">
                            Actualizar Contraseña
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            // (La misma lógica de SweetAlert y validaciones de contraseña que ya tenías)
            const swalType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swalType));
            const swalTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swalTitle));
            const swalMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swalMessage));
            const passwordForm = document.getElementById('changePasswordForm');

            if (swalType && swalTitle && typeof Swal !== 'undefined') {
                Swal.fire({ icon: swalType, title: swalTitle, text: swalMessage ?? '', confirmButtonColor: '#0d6efd', borderRadius: '16px' });
            }

            if (passwordForm) {
                passwordForm.addEventListener('submit', function(e) {
                    const newPass = document.getElementById('newPassword').value;
                    const confirmPass = document.getElementById('confirmPassword').value;
                    if (newPass !== confirmPass) {
                        e.preventDefault();
                        Swal.fire({ icon: 'warning', title: 'No coinciden', text: 'La nueva contraseña y su confirmación deben ser idénticas.', confirmButtonColor: '#0d6efd' });
                    }
                });
            }
        })();
    </script>
}