@model List<BioLIS.Models.Entities.Patient>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th class="ps-4">Paciente</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Última actualización</th>
                <th class="text-end pe-4">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr><td colspan="5" class="text-center p-4 text-muted">No hay pacientes desactivados.</td></tr>
            }
            else
            {
                foreach (var patient in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@patient.FullName</td>
                        <td>@(string.IsNullOrWhiteSpace(patient.Email) ? "Sin email" : patient.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(patient.PhoneNumber) ? "Sin teléfono" : patient.PhoneNumber)</td>
                        <td>@(patient.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Desconocida")</td>
                        <td class="text-end pe-4">
                            <form asp-action="ReactivatePatient" asp-route-id="@patient.PatientID" method="post" class="d-inline reactivate-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
