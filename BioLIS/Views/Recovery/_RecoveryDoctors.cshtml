@model List<BioLIS.Models.Entities.Doctor>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th class="ps-4">Médico</th>
                <th>Licencia</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Última actualización</th>
                <th class="text-end pe-4">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr><td colspan="6" class="text-center p-4 text-muted">No hay médicos desactivados.</td></tr>
            }
            else
            {
                foreach (var doctor in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@doctor.FullName</td>
                        <td>@(string.IsNullOrWhiteSpace(doctor.LicenseNumber) ? "Sin licencia" : doctor.LicenseNumber)</td>
                        <td>@(string.IsNullOrWhiteSpace(doctor.Email) ? "Sin email" : doctor.Email)</td>
                        <td>@(string.IsNullOrWhiteSpace(doctor.PhoneNumber) ? "Sin teléfono" : doctor.PhoneNumber)</td>
                        <td>@(doctor.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Desconocida")</td>
                        <td class="text-end pe-4">
                            <form asp-action="ReactivateDoctor" asp-route-id="@doctor.DoctorID" method="post" class="d-inline reactivate-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
