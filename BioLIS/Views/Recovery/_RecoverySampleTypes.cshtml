@model List<BioLIS.Models.Entities.SampleType>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th class="ps-4">Tipo de Muestra</th>
                <th>Color del Tubo</th>
                <th class="text-end pe-4">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr><td colspan="3" class="text-center p-4 text-muted">No hay tipos de muestra desactivados.</td></tr>
            }
            else
            {
                foreach (var sample in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@sample.SampleName</td>
                        <td>@(string.IsNullOrWhiteSpace(sample.ContainerColor) ? "Sin color" : sample.ContainerColor)</td>
                        <td class="text-end pe-4">
                            <form asp-action="ReactivateSampleType" asp-route-id="@sample.SampleID" method="post" class="d-inline reactivate-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success rounded-pill fw-bold">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
