@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    var role = User.FindFirstValue(ClaimTypes.Role);
    var username = User.FindFirstValue(ClaimTypes.Name);
}

<link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />

<div class="container-fluid mt-2 dashboard-home bg-transparent border-0 shadow-none p-0">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-end mb-4 animate-fade-up">
        <div>
            <h2 class="fw-bold text-dark mb-1">Centro de Mando</h2>
            <p class="text-muted mb-0">Bienvenido de nuevo, <strong>@username</strong>. Aquí está el resumen de hoy.</p>
        </div>
        <div class="text-muted small fw-bold">
            <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6 animate-fade-up delay-100">
            <div class="card premium-card border-bottom-primary h-100 py-2 hover-pulse">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                            @(role == "Doctor" ? "Mis Órdenes Hoy" : "Órdenes Hoy")
                        </div>
                        <div class="fs-3 fw-bold text-dark">
                            @(role == "Doctor" ? ViewBag.MyTodayOrders ?? ViewBag.TodayOrders : ViewBag.TodayOrders)
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="fas fa-file-medical fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 animate-fade-up delay-200">
            <div class="card premium-card border-bottom-success h-100 py-2 hover-pulse">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs fw-bold text-success text-uppercase mb-1">Pacientes Activos</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.TotalPatients</div>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="fas fa-users fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 animate-fade-up delay-300">
            <div class="card premium-card border-bottom-info h-100 py-2 hover-pulse">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs fw-bold text-info text-uppercase mb-1">Plantilla Médica</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.TotalDoctors</div>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                        <i class="fas fa-user-md fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 animate-fade-up delay-400">
            <div class="card premium-card border-bottom-warning h-100 py-2 hover-pulse">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">Pruebas en Catálogo</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.TotalTests</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="fas fa-vials fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="d-flex flex-wrap justify-content-center gap-3 mb-5 animate-pop-in delay-200">
        <a asp-controller="Patients" asp-action="Create" class="btn btn-outline-primary px-4 py-2 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i> Registrar Paciente
        </a>
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary px-4 py-2 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i> Crear Orden
        </a>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold rounded-pill shadow-sm">
            <i class="bi bi-search me-2"></i> Ver Todo
        </a>
    </div>

    <!-- Contenido -->
    <div class="row g-4 animate-fade-up delay-400">
        <!-- Tabla -->
        <div class="col-lg-7">
            <div class="card premium-card h-100">
                <div class="premium-card-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Órdenes Recientes</h5>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light text-primary fw-bold">Ver todas</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-4">Orden</th>
                                    <th>Paciente</th>
                                    <th>Estado</th>
                                    <th class="pe-4 text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentOrders != null)
                                {
                                    foreach (var order in (List<BioLIS.Models.Entities.Order>)ViewBag.RecentOrders)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">@order.OrderNumber</td>
                                            <td>@order.Patient?.FullName</td>
                                            <td>
                                                @if (order.Status == "Aprobada")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Aprobada</span>
                                                }
                                                else if (order.Status == "Completada")
                                                {

                                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3">Completada</span>
                                                }
                                                else if (order.Status == "EnProceso")
                                                {

                                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">En Proceso</span>
                                                }
                                                else
                                                {

                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Pendiente</span>
                                                }
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a asp-controller="Orders" asp-action="Details" asp-route-orderId="@order.OrderID" class="btn btn-sm btn-light text-primary rounded-circle"><i class="bi bi-chevron-right"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráficos -->
        <div class="col-lg-5">
            <div class="card premium-card mb-4">
                <div class="premium-card-header">
                    <h5 class="fw-bold text-dark mb-0">Estado Diario</h5>
                </div>
                <div class="card-body" style="height: 220px;">
                    <canvas id="ordersByStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Lógica de los gráficos (Idéntica a la que ya tenías, funciona perfecto)
        const statusLabels = @Html.Raw((string?)ViewData["ChartStatusLabels"] ?? "[]");
        const statusValues = @Html.Raw((string?)ViewData["ChartStatusValues"] ?? "[]");
        const statusCtx = document.getElementById('ordersByStatusChart');
        if (statusCtx) {
            new Chart(statusCtx, {
                type: 'doughnut',
                data: { labels: statusLabels, datasets: [{ data: statusValues, borderWidth: 0, backgroundColor: ['#e2e8f0', '#f6c23e', '#36b9cc', '#1cc88a', '#4e73df'] }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '75%', plugins: { legend: { position: 'right' } } }
            });
        }
    </script>
}